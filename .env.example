# Copie este arquivo para .env e preencha os valores

# Modelo juiz para DeepEval (padrão: gpt-4o)
OPENAI_API_KEY=sk-...
DEEPEVAL_MODEL=gpt-4o

# Credenciais AWS (alternativa ao aws configure)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...
# AWS_DEFAULT_REGION=us-east-2
